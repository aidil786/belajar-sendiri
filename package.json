{
  "name": "fahamlah",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "FahamLah: an ADHD-friendly, bilingual (English + Malay) Git & GitHub course.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-headers.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:readability": "tsx scripts/check-readability/index.ts",
    "check:cards": "tsx scripts/check-card-ids/index.ts",
    "verify:commands": "tsx scripts/verify-commands/index.ts",
    "verify:docker": "tsx scripts/verify-docker/index.ts",
    "verify:manifests": "tsx scripts/verify-manifests/index.ts",
    "verify:workflows": "tsx scripts/verify-workflows/index.ts",
    "verify:k8s": "tsx scripts/verify-k8s/index.ts",
    "verify:tofu": "tsx scripts/verify-tofu/index.ts",
    "verify:linux": "tsx scripts/verify-linux/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "deploy:dry": "npm run build && node scripts/deploy-dry.mjs",
    "check:mdx": "tsx scripts/check-mdx/index.ts",
    "deploy": "npm run build && wrangler pages deploy --branch main --commit-dirty=true",
    "icons": "tsx scripts/make-icons/index.ts",
    "verify:promql": "tsx scripts/verify-promql/index.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@nanostores/react": "^2.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.4.4",
    "gsap": "^3.15.0",
    "motion": "^14.9.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
