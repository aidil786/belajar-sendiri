# Security and caching headers for Cloudflare Pages (same _headers format as Workers static assets).
# Every page. scripts/csp-headers.mjs fills in the inline script hashes after the build.
# Scripts: only from this site (plus those hashed inline ones). Network: this site and the public
# GitHub API (mission checks). Inline styles stay allowed (style="" attributes are everywhere).
# No frames, no plugins, nobody may embed the site in a frame.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com __CSP_CONNECT_EXTRA__; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker: always check for a new version (the build id inside changes every deploy).
/sw.js
  Cache-Control: no-cache
  Content-Type: text/javascript; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/:lang/lessons.json
  Cache-Control: no-cache
