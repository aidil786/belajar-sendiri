---
// A hint inside a card. Hidden until the learner presses Hint (or the ? key).
import { isLang, t } from '~/i18n';
const seg = Astro.url.pathname.split('/')[1];
const lang = isLang(seg) ? seg : 'en';
---

<div class="card-hint" data-hint hidden>
  <p class="card-hint-title">{t(lang, 'lesson.hintTitle')}</p>
  <slot />
</div>
