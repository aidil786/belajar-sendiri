---
// The other language's version of a card, kept in an inert <template>.
// The Peek button copies it into a small panel under the card.
interface Props {
  id: string;
  type: string;
  audio?: string;
}
const { id, type } = Astro.props;
---

{
  type !== 'deeper' && (
    <template data-peek-for={id}>
      <slot />
    </template>
  )
}
