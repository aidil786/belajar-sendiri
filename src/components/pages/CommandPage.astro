---
// One page per command: what it does, when to use it, an example, and its risk.
// /en/commands/<id>/ (Git) and /en/<course>/commands/<id>/ (other courses).
import Base from '~/layouts/Base.astro';
import DangerBadge from '~/components/ui/DangerBadge.astro';
import { t, type Lang } from '~/i18n';
import { getCourse } from '~/lib/course';
import { getCommands, lessonLinks } from '~/lib/content';
import { commandHref, toolHref } from '~/lib/catalog';

type Command = Awaited<ReturnType<typeof getCommands>>['commands'][number];
interface Props {
  lang: Lang;
  courseId: string;
  cmd: Command;
}
const { lang, courseId, cmd } = Astro.props;
const other = lang === 'en' ? 'ms' : 'en';
const course = await getCourse(courseId);
const links = await lessonLinks(lang, courseId);
const lesson = cmd.lesson ? links[cmd.lesson] : undefined;
const title = cmd.syntax.split(/\s+[[<|·]/)[0]!.trim();
---

<Base lang={lang} title={title} description={cmd.what[lang]} altPath={commandHref(other, courseId, cmd.id)}>
  <article class="container cmd">
    <p class="crumb"><a href={toolHref(lang, course, 'commands')}>{t(lang, 'commands.title')}</a></p>
    <h1><code>{title}</code></h1>
    <p class="syntax"><code>{cmd.syntax}</code></p>
    <p><DangerBadge lang={lang} level={cmd.danger} /></p>
    <h2>{t(lang, 'commands.what')}</h2>
    <p>{cmd.what[lang]}</p>
    <h2>{t(lang, 'commands.when')}</h2>
    <p>{cmd.when[lang]}</p>
    <h2>{t(lang, 'commands.example')}</h2>
    <div class="example">
      <pre><code>$ {cmd.example.command}</code></pre>
      <p>{cmd.example[lang]}</p>
    </div>
    {
      cmd.variants.map((v) => (
        <div class="example">
          <pre><code>$ {v.command}</code></pre>
          <p>{v[lang]}</p>
        </div>
      ))
    }
    <p class="links">
      {
        lesson && (
          <>
            {t(lang, 'commands.learnedIn')}: <a href={lesson.url}>{lesson.title}</a> ·{' '}
          </>
        )
      }
      <a href={cmd.docs} rel="noopener" target="_blank">{t(lang, 'commands.docs')}</a>
    </p>
  </article>
</Base>

<style>
  .cmd {
    padding-block: var(--space-5);
    max-width: 44rem;
  }
  .crumb {
    font-size: var(--text-s);
    margin-bottom: var(--space-2);
  }
  h1 code {
    background: none;
    border: 0;
    font-size: 1em;
    padding: 0;
  }
  .syntax code {
    white-space: pre-wrap;
  }
  h2 {
    font-size: var(--text-l);
    margin-top: var(--space-5);
  }
  .example {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }
  .example pre {
    margin: 0 0 var(--space-2);
    background: var(--term-bg);
    color: var(--term-fg);
    border-radius: var(--radius-s);
    padding: var(--space-2) var(--space-3);
    overflow-x: auto;
  }
  .example p {
    margin: 0;
  }
  .links {
    margin-top: var(--space-5);
  }
</style>
