  bell: '<path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z"/><path d="M10 20a2 2 0 0 0 4 0"/>',
  notebook: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M5 7H3M5 12H3M5 17H3"/><path d="M9 8h6M9 12h6M9 16h3"/>',
