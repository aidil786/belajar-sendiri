---
// Kancil: an original mouse deer, inspired by Sang Kancil from Malay folk tales.
// Moods: happy, thinking, oops. The lesson player sets data-mood. Static in calm mode.
// Hats (Ship It): chef's hat (Docker), hard hat (CI/CD), captain's cap (Kubernetes).
// Outfits (Level Up): tool belt (Linux), pencil behind the ear (IaC), headset (Observability),
// staff lanyard (AWS). Original drawings, tokens only, nothing moves.
import { t, type Lang } from '~/i18n';
import type { Hat } from '~/lib/catalog';
interface Props {
  lang: Lang;
  mood?: 'happy' | 'thinking' | 'oops' | 'idle';
  size?: number;
  hat?: Hat | undefined;
}
const { lang, mood = 'idle', size = 72, hat } = Astro.props;
const label = hat ? t(lang, `mascot.hat.${hat}`) : t(lang, 'mascot.label');
---

<div class="mascot" data-mood={mood} data-hat={hat} role="img" aria-label={label} data-mascot>
  <svg width={size} height={size} viewBox="0 0 120 120" aria-hidden="true">
    <!-- body -->
    <ellipse cx="62" cy="78" rx="30" ry="18" class="m-body"></ellipse>
    <!-- thin legs -->
    <path d="M44 92 L42 112 M52 94 L52 112 M74 94 L76 112 M82 91 L86 111" class="m-leg"></path>
    <!-- tail -->
    <path d="M91 72 q8 -4 6 -10" class="m-leg"></path>
    <!-- neck + head -->
    <path d="M40 72 Q34 54 42 42" class="m-neck"></path>
    <ellipse cx="44" cy="40" rx="17" ry="13" class="m-body"></ellipse>
    {hat === 'pencil' && (
      // Behind the ear: drawn before the ear, so the ear sits over it.
      <g class="m-hat" transform="rotate(-15 54 27)">
        <rect x="38" y="24.5" width="24.5" height="5" class="m-pencil" />
        <rect x="62" y="24.5" width="2.5" height="5" class="m-pencil-band" />
        <rect x="64.5" y="24.5" width="4" height="5" rx="1.2" class="m-pencil-eraser" />
        <path d="M38 24.5 L32 27 L38 29.5 Z" class="m-pencil-wood" />
        <path d="M33.8 26.25 L32 27 L33.8 27.75 Z" class="m-nose" />
      </g>
    )}
    <!-- snout -->
    <ellipse cx="29" cy="46" rx="8" ry="6" class="m-snout"></ellipse>
    <circle cx="23.5" cy="45" r="2.4" class="m-nose"></circle>
    <!-- ears -->
    <ellipse cx="52" cy="24" rx="5" ry="10" transform="rotate(18 52 24)" class="m-body"></ellipse>
    <ellipse
      cx="52"
      cy="25"
      rx="2.4"
      ry="6"
      transform="rotate(18 52 25)"
      class="m-ear-in"
    ></ellipse>
    <!-- belly patch -->
    <ellipse cx="60" cy="86" rx="18" ry="7" class="m-belly"></ellipse>
    <!-- eyes by mood -->
    <g class="m-eyes m-eyes-idle">
      <circle cx="42" cy="37" r="4.2" class="m-eye"></circle>
      <circle cx="43.2" cy="35.8" r="1.4" class="m-shine"></circle>
    </g>
    <g class="m-eyes m-eyes-happy">
      <path d="M37 38 q5 -6 10 0" class="m-line"></path>
    </g>
    <g class="m-eyes m-eyes-thinking">
      <circle cx="44" cy="35" r="4.2" class="m-eye"></circle>
      <circle cx="45.5" cy="33.6" r="1.4" class="m-shine"></circle>
      <circle cx="70" cy="22" r="3" class="m-bubble"></circle>
      <circle cx="78" cy="14" r="4.5" class="m-bubble"></circle>
    </g>
    <g class="m-eyes m-eyes-oops">
      <path d="M38 34 l8 6 M46 34 l-8 6" class="m-line"></path>
    </g>
    <!-- mouth -->
    <path d="M27 52 q4 3 8 0" class="m-line m-mouth"></path>
    {hat === 'chef' && (
      <g class="m-hat">
        <circle cx="35" cy="20" r="6.5" class="m-chef" />
        <circle cx="44" cy="15" r="7.5" class="m-chef" />
        <circle cx="53" cy="20" r="6.5" class="m-chef" />
        <rect x="31" y="20" width="26" height="9" rx="2" class="m-chef" />
        <path d="M33 25h22" class="m-chef-line" />
      </g>
    )}
    {hat === 'hardhat' && (
      <g class="m-hat">
        <path d="M31 28 Q31 13 44 13 Q57 13 57 28 Z" class="m-hard" />
        <path d="M44 14v13" class="m-hard-ridge" />
        <path d="M26 28.5h35" class="m-hard-brim" />
      </g>
    )}
    {hat === 'captain' && (
      <g class="m-hat">
        <path d="M31 26 Q32 14 45 14 Q58 15 57 26 Z" class="m-captain" />
        <rect x="31" y="23" width="26" height="5" rx="1.5" class="m-captain-band" />
        <path d="M32 27.5 Q25 28 21 32 Q28 33 34 29 Z" class="m-captain" />
        <circle cx="44" cy="19.5" r="2.4" class="m-captain-badge" />
      </g>
    )}
    {hat === 'toolbelt' && (
      <g class="m-hat">
        <path d="M71 61 Q74.5 78 71 95" class="m-belt" />
        <rect x="68" y="72.5" width="6" height="6" rx="1" class="m-belt-buckle" />
        <path d="M80.5 76 L83.5 67.5" class="m-belt-tool" />
        <circle cx="84" cy="66" r="2.2" class="m-belt-tool" />
        <rect x="75" y="75.5" width="11" height="10" rx="2" class="m-belt-pouch" />
      </g>
    )}
    {hat === 'headset' && (
      <g class="m-hat">
        <path d="M31 34 Q42 15 57 30" class="m-headset-band" />
        <path d="M53 40 Q45 54 35.5 53" class="m-headset-boom" />
        <circle cx="55" cy="36" r="5" class="m-headset" />
        <circle cx="34.5" cy="53" r="2.4" class="m-headset" />
      </g>
    )}
    {hat === 'lanyard' && (
      <g class="m-hat">
        <path d="M35 48 Q31 57 35.5 64 M46 47 Q42 57 37.5 64" class="m-lanyard" />
        <rect x="31" y="63" width="11" height="13" rx="1.5" class="m-card" />
        <circle cx="36.5" cy="67.5" r="1.7" class="m-card-ink" />
        <path d="M33.5 72 h6" class="m-card-line" />
      </g>
    )}
  </svg>
</div>

<style>
  .mascot {
    display: inline-block;
    line-height: 0;
    transform-origin: bottom center;
  }
  .m-body {
    fill: var(--mascot-fur);
  }
  .m-neck {
    fill: none;
    stroke: var(--mascot-fur);
    stroke-width: 14;
    stroke-linecap: round;
  }
  .m-leg {
    fill: none;
    stroke: var(--mascot-fur-dark);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .m-snout,
  .m-belly {
    fill: var(--mascot-light);
  }
  .m-ear-in {
    fill: var(--mascot-light);
  }
  .m-nose,
  .m-eye {
    fill: var(--mascot-ink);
  }
  .m-shine {
    fill: var(--mascot-light);
  }
  .m-line {
    fill: none;
    stroke: var(--mascot-ink);
    stroke-width: 2.6;
    stroke-linecap: round;
  }
  .m-bubble {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: 1.5;
  }
  .m-chef {
    fill: var(--mascot-hat-chef);
    stroke: var(--mascot-hat-chef-line);
    stroke-width: 1.5;
  }
  .m-chef-line {
    fill: none;
    stroke: var(--mascot-hat-chef-line);
    stroke-width: 1.5;
  }
  .m-hard {
    fill: var(--mascot-hat-hard);
    stroke: var(--mascot-hat-hard-dark);
    stroke-width: 1.5;
  }
  .m-hard-ridge {
    fill: none;
    stroke: var(--mascot-hat-hard-dark);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .m-hard-brim {
    fill: none;
    stroke: var(--mascot-hat-hard-dark);
    stroke-width: 3.5;
    stroke-linecap: round;
  }
  .m-captain {
    fill: var(--mascot-hat-captain);
  }
  .m-captain-band {
    fill: var(--mascot-ink);
  }
  .m-captain-badge {
    fill: var(--mascot-hat-trim);
  }
  .m-pencil {
    fill: var(--mascot-pencil);
  }
  .m-pencil-band {
    fill: var(--mascot-tool);
  }
  .m-pencil-eraser {
    fill: var(--mascot-pencil-eraser);
  }
  .m-pencil-wood {
    fill: var(--mascot-light);
  }
  .m-belt {
    fill: none;
    stroke: var(--mascot-belt);
    stroke-width: 6;
  }
  .m-belt-buckle {
    fill: none;
    stroke: var(--mascot-hat-trim);
    stroke-width: 1.8;
  }
  .m-belt-pouch {
    fill: var(--mascot-belt);
  }
  .m-belt-tool {
    fill: none;
    stroke: var(--mascot-tool);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .m-headset,
  .m-card-ink {
    fill: var(--mascot-headset);
  }
  .m-headset-band {
    fill: none;
    stroke: var(--mascot-headset);
    stroke-width: 3.2;
    stroke-linecap: round;
  }
  .m-headset-boom {
    fill: none;
    stroke: var(--mascot-headset);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .m-lanyard {
    fill: none;
    stroke: var(--mascot-lanyard);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .m-card {
    fill: var(--mascot-hat-chef);
    stroke: var(--mascot-ink);
    stroke-width: 1.2;
  }
  .m-card-line {
    fill: none;
    stroke: var(--mascot-lanyard);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .m-eyes {
    display: none;
  }
  .mascot[data-mood='idle'] .m-eyes-idle,
  .mascot[data-mood='happy'] .m-eyes-happy,
  .mascot[data-mood='thinking'] .m-eyes-thinking,
  .mascot[data-mood='oops'] .m-eyes-oops {
    display: inline;
  }
  .mascot[data-mood='happy'] {
    animation: kancil-hop 600ms var(--ease-out) 1;
  }
  .mascot[data-mood='oops'] {
    animation: kancil-tilt 500ms ease-in-out 1;
  }
  @keyframes kancil-hop {
    0%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
  }
  @keyframes kancil-tilt {
    0%,
    100% {
      transform: rotate(0);
    }
    50% {
      transform: rotate(-6deg);
    }
  }
</style>
