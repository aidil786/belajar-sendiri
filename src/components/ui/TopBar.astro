---
import { safeJson } from '~/lib/safe-json';
// Top bar: brand, a calm course switcher, the map and tools of the current course, settings, language.
// The current course is the one in the URL (/en/docker/…). Pages without one (home, settings, review)
// follow the course the learner is working on (their resume point), else the first course.
import { t, type Lang } from '~/i18n';
import { familyTitle, getCourses, type Course } from '~/lib/course';
import { placeOfPath, ROOT_COURSE, toolHref } from '~/lib/catalog';
import Icon from './Icon.astro';
import LangToggle from './LangToggle.astro';
interface Props {
  lang: Lang;
  altPath: string;
}
const { lang, altPath } = Astro.props;
const here = Astro.url.pathname;
const courses = await getCourses();
const place = placeOfPath(here, courses.map((c) => c.id));
const family = place.family ?? courses.find((c) => c.id === place.course)?.family;
const current = courses.find((c) => c.id === place.course) ?? courses.find((c) => c.family === family) ?? courses.find((c) => c.id === ROOT_COURSE)!;
// A family overview (/en/ship-it/) is its own map.
const mapHref = (c: Course) => (place.family && c.family === place.family ? `/${lang}/${place.family}/` : `/${lang}/${c.id}/`);
const toolsFor = (c: Course) => ({
  map: mapHref(c),
  glossary: toolHref(lang, c, 'glossary'),
  cheatsheet: toolHref(lang, c, 'cheatsheet'),
  commands: toolHref(lang, c, 'commands'),
  rescue: toolHref(lang, c, 'rescue'),
});
const tools = toolsFor(current);
const links = [
  { tool: 'glossary', href: tools.glossary, label: t(lang, 'nav.glossary'), icon: 'book' },
  { tool: 'cheatsheet', href: tools.cheatsheet, label: t(lang, 'nav.cheatsheet'), icon: 'sheet' },
  { tool: 'commands', href: tools.commands, label: t(lang, 'nav.commands'), icon: 'terminal' },
  { tool: 'rescue', href: tools.rescue, label: t(lang, 'nav.rescue'), icon: 'lifebuoy' },
  { tool: 'review', href: `/${lang}/review/`, label: t(lang, 'nav.review'), icon: 'review' },
  { tool: 'feedback', href: `/${lang}/feedback/`, label: t(lang, 'footer.feedback'), icon: 'star' },
];
const shortName = (c: Course) => c.title[lang];
// Menu: the first course, then each family with its parts.
const families = [...new Set(courses.map((c) => c.family).filter((f): f is string => Boolean(f)))];
const loose = courses.filter((c) => !c.family);
// For the browser: tool links of every course, so pages without a course can follow the learner.
const switchData = place.course || place.family ? null : Object.fromEntries(courses.map((c) => [c.id, { name: shortName(c), ...toolsFor(c) }]));
const isCurrent = (href: string) => here.startsWith(href);
---

<header class="topbar">
  <div class="topbar-inner container">
    <a class="brand" href={`/${lang}/`} aria-label={`${t(lang, 'site.name')}, ${t(lang, 'nav.home')}`}>
      <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"
        ><rect x="1.5" y="1.5" width="29" height="29" rx="9" class="brand-bg"></rect><path
          d="M7.5 9v14h4.6a3.5 3.5 0 0 0 0-7H7.5h4.1a3.5 3.5 0 0 0 0-7z M24.5 11.6c-.6-1.6-2-2.6-3.8-2.6-2.2 0-3.7 1.3-3.7 3.2 0 4.3 7.8 2.5 7.8 6.9 0 2.1-1.6 3.4-4 3.4-1.9 0-3.4-.9-4.1-2.6"
          class="brand-mark"></path></svg
      >
      <span class="brand-name">{t(lang, 'site.name')}</span>
    </a>
    <span class="xp calm-hide" data-xp data-level-text={t(lang, 'xp.level')} data-sr-text={t(lang, 'xp.chip')} hidden>
      <span class="xp-level" data-xp-level aria-hidden="true">{t(lang, 'xp.level', { n: 1 })}</span>
      <span class="xp-bar" aria-hidden="true"><span class="xp-fill" data-xp-fill></span></span>
      <span class="visually-hidden" data-xp-sr></span>
    </span>
    <nav aria-label={t(lang, 'nav.main')} class="topnav">
      <details class="menu courses" data-course-menu>
        <summary class="topnav-link">
          <Icon name="compass" size={22} />
          <span class="topnav-label"><span class="visually-hidden">{t(lang, 'nav.course')}: </span><span data-current-course>{place.family && !place.course ? familyTitle(lang, place.family) : shortName(current)}</span></span>
          <span class="tab-label" aria-hidden="true">{t(lang, 'tab.course')}</span>
        </summary>
        <ul class="menu-list">
          {
            loose.map((c) => (
              <li>
                <a href={`/${lang}/${c.id}/`} aria-current={place.course === c.id ? 'page' : undefined}>
                  {shortName(c)}
                </a>
              </li>
            ))
          }
          {
            families.map((f) => (
              <li>
                <a href={`/${lang}/${f}/`} aria-current={place.family === f ? 'page' : undefined}>
                  {familyTitle(lang, f)}
                </a>
                <ul class="menu-sub">
                  {courses
                    .filter((c) => c.family === f)
                    .map((c) => (
                      <li>
                        <a href={`/${lang}/${c.id}/`} aria-current={place.course === c.id ? 'page' : undefined}>
                          {c.part ? `${t(lang, 'catalog.partShort', { n: c.part })} · ` : ''}
                          {shortName(c)}
                        </a>
                      </li>
                    ))}
                </ul>
              </li>
            ))
          }
          <li class="menu-all">
            <a href={`/${lang}/`}>{t(lang, 'nav.allCourses')}</a>
          </li>
        </ul>
      </details>
      <a href={tools.map} class="topnav-link" data-tool-link="map" aria-current={here === tools.map ? 'page' : undefined}>
        <Icon name="map" size={22} /><span class="topnav-label">{t(lang, 'nav.map')}</span>
        <span class="tab-label" aria-hidden="true">{t(lang, 'tab.map')}</span>
      </a>
      <details class="menu tools">
        <summary class="topnav-link">
          <Icon name="tools" size={22} /><span class="topnav-label">{t(lang, 'nav.tools')}</span>
          <span class="tab-label" aria-hidden="true">{t(lang, 'tab.tools')}</span>
        </summary>
        <ul class="menu-list">
          {
            links.map((l) => (
              <li>
                <a href={l.href} data-tool-link={l.tool} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                  <Icon name={l.icon} size={18} />
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href={`/${lang}/settings/`} class="topnav-link" aria-current={here.startsWith(`/${lang}/settings/`) ? 'page' : undefined}>
        <Icon name="settings" size={22} /><span class="topnav-label">{t(lang, 'nav.settings')}</span>
        <span class="tab-label" aria-hidden="true">{t(lang, 'tab.settings')}</span>
      </a>
      <LangToggle lang={lang} altPath={altPath} />
    </nav>
  </div>
  {switchData && <script type="application/json" data-course-switch set:html={safeJson(switchData)} />}
</header>

<script>
  import { $progress } from '~/stores/progress';
  // Pages without a course in the URL: the map and tools follow the course the learner is working on.
  const el = document.querySelector('[data-course-switch]');
  if (el) {
    const all = JSON.parse(el.textContent ?? '{}') as Record<string, Record<string, string>>;
    const course = /^\/(?:en|ms)\/([\w-]+)\//.exec($progress.get().resume?.path ?? '')?.[1];
    const tools = course ? all[course] : undefined;
    if (tools) {
      for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-tool-link]')) {
        const href = tools[a.dataset.toolLink ?? ''];
        if (href) a.href = href;
      }
      const label = document.querySelector('[data-current-course]');
      if (label && tools.name) label.textContent = tools.name;
    }
  }
  // Level chip: 100 XP per level. Calm mode hides it (.calm-hide).
  const xp = document.querySelector<HTMLElement>('[data-xp]');
  if (xp) {
    const fill = xp.querySelector<HTMLElement>('[data-xp-fill]')!;
    const level = xp.querySelector<HTMLElement>('[data-xp-level]')!;
    const sr = xp.querySelector<HTMLElement>('[data-xp-sr]')!;
    const fmt = (text: string, v: Record<string, number>) => text.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
    const showXp = () => {
      const p = $progress.get();
      // Calm mode: no XP anywhere, not even for screen readers.
      if (p.settings.calm) {
        xp.hidden = true;
        sr.textContent = '';
        return;
      }
      const points = Math.max(0, Math.floor(p.xp || 0));
      const n = 1 + Math.floor(points / 100);
      const into = points % 100;
      level.textContent = fmt(xp.dataset.levelText ?? '{n}', { n });
      sr.textContent = fmt(xp.dataset.srText ?? '', { level: n, xp: points, left: 100 - into });
      fill.style.inlineSize = `${into}%`;
      xp.hidden = false;
    };
    showXp();
    $progress.listen(showXp);
  }
  // Only one menu open at a time; Escape or a click outside closes it.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.topnav details.menu')];
  for (const m of menus) {
    m.addEventListener('toggle', () => {
      if (m.open) for (const other of menus) if (other !== m) other.open = false;
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const m of menus) {
      if (m.open) {
        m.open = false;
        m.querySelector('summary')?.focus();
      }
    }
  });
  document.addEventListener('click', (e) => {
    for (const m of menus) if (m.open && !m.contains(e.target as Node)) m.open = false;
  });
</script>

<style>
  /* An ink bar: the brand, the level chip and the menus. On phones the menus become a tab bar at the bottom. */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bar-bg);
    color: var(--bar-fg);
    border-bottom: var(--line);
    --focus-ring: var(--candy-sun);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--topbar-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-head);
    font-weight: var(--weight-head);
    font-size: var(--text-l);
    letter-spacing: -0.01em;
    text-decoration: none;
    min-height: var(--tap);
    margin-right: auto;
  }
  .brand-bg {
    fill: var(--candy-mint);
    stroke: var(--bar-fg);
    stroke-width: 2.5;
  }
  .brand-mark {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Level chip: "Level 3" and a little bar to the next level. Never a streak. */
  .xp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 34px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    border: 2px solid var(--bar-muted);
    font-family: var(--font-head);
    font-weight: var(--weight-head);
    font-size: var(--text-s);
    white-space: nowrap;
  }
  .xp[hidden] {
    display: none;
  }
  .xp-bar {
    inline-size: 3.5rem;
    block-size: 10px;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--bar-fg) 22%, transparent);
    overflow: hidden;
  }
  .xp-fill {
    display: block;
    block-size: 100%;
    inline-size: 0;
    background: var(--candy-sun);
    border-radius: inherit;
    transition: inline-size var(--dur-ui) var(--ease-out);
  }
  .topnav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .topnav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    min-width: var(--tap);
    justify-content: center;
    padding: 0 var(--space-2);
    border-radius: var(--radius-s);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-s);
    font-weight: var(--weight-bold);
  }
  .topnav-link::-webkit-details-marker {
    display: none;
  }
  .topnav-link:hover,
  .menu[open] > .topnav-link {
    background: color-mix(in oklab, var(--bar-fg) 14%, transparent);
  }
  .topnav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--candy-sun);
    text-underline-offset: 0.35em;
  }
  .tab-label {
    display: none;
  }
  .topnav :global(.lang-toggle) {
    border-color: var(--bar-muted);
  }
  .menu {
    position: relative;
  }
  /* The open menu is a white sticker. */
  .menu-list {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 2;
    min-width: 14rem;
    max-width: calc(100vw - 2 * var(--space-4));
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--lift);
    --focus-ring: var(--color-focus);
  }
  .courses .menu-list {
    right: auto;
    left: 0;
    /* Two families of parts: the list scrolls on short screens instead of running off them. */
    max-height: calc(100dvh - var(--topbar-h) - var(--space-5));
    overflow-y: auto;
  }
  .menu-sub {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-4);
    border-left: 2px solid var(--color-border);
    margin-left: var(--space-3);
  }
  .menu-all {
    border-top: 2px solid var(--color-border);
    margin-top: var(--space-1);
    padding-top: var(--space-1);
  }
  .menu-list a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    min-height: var(--tap);
    border-radius: var(--radius-s);
    text-decoration: none;
  }
  .menu-list a:hover {
    background: var(--color-surface-2);
  }
  .menu-list a[aria-current='page'] {
    font-weight: var(--weight-bold);
    background: var(--brand-soft);
  }
  @media (max-width: 860px) {
    /* Middle widths: icons only in the bar (labels stay for screen readers). */
    .topnav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 640px) {
    /* Phones: a tab bar at the bottom, in thumb reach, with an icon and a short word on each tab. */
    .topnav {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 30;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 2px;
      min-height: var(--tabbar-h);
      padding: 4px var(--space-1) calc(4px + env(safe-area-inset-bottom, 0px));
      background: var(--bar-bg);
      color: var(--bar-fg);
      border-top: var(--line);
    }
    .topnav > .menu,
    .topnav > .menu > .topnav-link {
      position: static;
    }
    .topnav-link,
    .topnav :global(.lang-toggle) {
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      min-width: 0;
      min-height: 52px;
      padding: 2px;
      border: 0;
      border-radius: var(--radius-m);
      font-size: var(--text-xs);
      line-height: 1.1;
    }
    .tab-label {
      display: block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .topnav-link[aria-current='page'] {
      text-decoration: none;
      background: color-mix(in oklab, var(--candy-mint) 24%, transparent);
    }
    /* Menus open upward from the tab bar and span the screen. */
    .menu-list,
    .courses .menu-list {
      position: fixed;
      top: auto;
      left: var(--space-3);
      right: var(--space-3);
      bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom, 0px) + 8px);
      min-width: 0;
      max-width: none;
      max-height: calc(100dvh - var(--topbar-h) - var(--tabbar-h) - var(--space-5));
      overflow-y: auto;
    }
    .brand {
      font-size: var(--text-m);
    }
  }
  @media (max-width: 420px) {
    .xp-bar {
      display: none;
    }
  }
</style>
