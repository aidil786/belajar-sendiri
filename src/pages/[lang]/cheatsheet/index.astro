---
// /en/cheatsheet/: the first course's cheat sheet (other courses: /en/<course>/cheatsheet/).
import CheatsheetPage from '~/components/pages/CheatsheetPage.astro';
import { LANGS, type Lang } from '~/i18n';
import { ROOT_COURSE } from '~/lib/catalog';
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---

<CheatsheetPage lang={lang} courseId={ROOT_COURSE} />
