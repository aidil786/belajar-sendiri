---
// /en/commands/: the first course's command pages (other courses: /en/<course>/commands/).
import CommandsPage from '~/components/pages/CommandsPage.astro';
import { LANGS, type Lang } from '~/i18n';
import { ROOT_COURSE } from '~/lib/catalog';
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---

<CommandsPage lang={lang} courseId={ROOT_COURSE} />
