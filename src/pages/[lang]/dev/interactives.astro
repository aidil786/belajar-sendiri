---
// Hidden test page: one of each newer interactive, for Playwright + axe.
// Not linked from any menu; noindex. Each demo marks itself data-done="true"
// when its interactive reports fl:done (like a lesson card does).
import Base from '~/layouts/Base.astro';
import Interactive from '~/components/lesson/Interactive.astro';
import { LANGS, t, type Lang } from '~/i18n';
import { KEDAI_GOAL, KEDAI_PALETTE } from '~/lib/composeSamples';
import dockerSizes from '~/lib/docker-sizes.json';
import '~/components/lesson/lesson.css';
import { doctorDemo, doctorTypoDemo, labelsDemo, mirrorApp, rbacDemo, rbacPredictDemo, schedDemo, templateDemo, traceDemo } from '~/lib/k8sDemos';
import { gateNaclDemo, gateSgDemo, iamEditDemo, iamPredictDemo, iamRoleDemo, idleDemo, subnetDemo, subnetVpcDemo } from '~/lib/aws/demos';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const other = lang === 'en' ? 'ms' : 'en';

const repo = {
  owner: 'aina-codes',
  name: 'diary',
  description: 'My little diary website.',
  files: [
    { path: 'README.md', content: '# Diary\n\nA tiny diary site.\n\n> [!TIP]\n> Read the [guide](CONTRIBUTING.md) first.\n\n- [x] Home page\n- [ ] Contact page\n' },
    { path: 'CONTRIBUTING.md', content: '# How to help\n\n1. Open an issue.\n2. Make a branch.\n3. Open a pull request.\n' },
    { path: 'index.html', content: '<h1>My diary</h1>\n<p>Day 1: I learned Git.</p>\n' },
  ],
};
const issues = [
  { number: 3, title: 'Add a contact page', body: 'Visitors cannot reach me. Please add a **contact** page.', state: 'open', author: 'mei', labels: ['enhancement'] },
  { number: 4, title: 'Typo on the home page', body: 'It says "Dairy" in one place.', state: 'open', author: 'sam' },
];
const pull = {
  number: 7,
  title: 'Add contact page',
  body: 'Adds a simple contact page.\n\nCloses #3',
  author: 'mei',
  from: 'contact-page',
  to: 'main',
  state: 'open',
  checks: [{ name: 'test', status: 'pass' }],
  files: [{ path: 'contact.html', diff: ['@@ -0,0 +1,2 @@', '+<h1>Contact</h1>', '+<p>Email me any time.</p>'] }],
};
const run = {
  id: 12,
  workflow: 'CI',
  event: 'push',
  branch: 'main',
  status: 'fail',
  jobs: [
    {
      name: 'test',
      steps: [
        { name: 'Check out code', status: 'pass', log: ['Fetching the repository', 'Done'] },
        { name: 'Run tests', status: 'fail', log: ['FAIL home.test.js', 'Expected "Diary" but got "Dairy"', 'Error: Process completed with exit code 1.'] },
        { name: 'Deploy', status: 'skipped' },
      ],
    },
  ],
};
const blocks = [
  { id: 'push', kind: 'trigger', label: 'On push', yaml: 'push:\n  branches: [main]', means: 'Run when someone pushes to main.' },
  { id: 'job', kind: 'job', label: 'Job: test', yaml: 'test:\n  runs-on: ubuntu-latest', means: 'Get a fresh Linux computer.' },
  { id: 'checkout', kind: 'step', label: 'Check out code', yaml: '- uses: actions/checkout@v7', means: 'Copy your code onto it.' },
  { id: 'node', kind: 'step', label: 'Set up Node', yaml: '- uses: actions/setup-node@v7\n  with:\n    node-version: 24', means: 'Install Node.' },
  { id: 'test', kind: 'step', label: 'Run tests', yaml: '- run: npm test', means: 'Run the tests.' },
  { id: 'deploy', kind: 'step', label: 'Deploy', yaml: '- run: npm run deploy', means: 'Publish the site.', why: 'This workflow only tests. Deploying comes later.' },
];

// Ship It Docker games (tests/e2e/docker-games.spec.ts). Layer sizes are the measured ones.
const kek = Object.fromEntries(dockerSizes.kekLapis.good.map((l) => [l.line.split(' ')[0] === 'COPY' ? l.line : l.line.split(' ')[0], l.size]));
const kekSlow = [
  { id: 'from', text: 'FROM node:24-alpine', size: dockerSizes.kekLapis.base.bytes },
  { id: 'workdir', text: 'WORKDIR /app', size: kek.WORKDIR },
  { id: 'copy-all', text: 'COPY . .', size: kek['COPY . .'] },
  { id: 'copy-pkg', text: 'COPY package.json package-lock.json ./', size: kek['COPY package.json package-lock.json ./'] },
  { id: 'install', text: 'RUN npm ci --omit=dev', size: kek.RUN },
  { id: 'cmd', text: 'CMD ["node", "server.js"]' },
];
const kekPick = [
  { id: 'from', text: 'FROM node:24-alpine', size: dockerSizes.kekLapis.base.bytes },
  { id: 'workdir', text: 'WORKDIR /app', size: kek.WORKDIR },
  { id: 'first', text: 'COPY . .', size: kek['COPY . .'], changes: [{ text: 'COPY package.json package-lock.json ./', size: kek['COPY package.json package-lock.json ./'] }] },
  { id: 'install', text: 'RUN npm ci --omit=dev', size: kek.RUN },
  { id: 'rest', text: 'COPY . .', size: kek['COPY . .'] },
  { id: 'cmd', text: 'CMD ["node", "server.js"]' },
];
---

<Base lang={lang} title={t(lang, 'dev.title')} altPath={`/${other}/dev/interactives/`} noindex>
  <div class="container dev-page">
    <h1>{t(lang, 'dev.title')}</h1>
    <p>{t(lang, 'dev.note')}</p>

    <section class="dev-demo card-content" data-demo="transcript" aria-labelledby="demo-transcript">
      <h2 id="demo-transcript">Transcript</h2>
      <Interactive
        name="Transcript"
        title="bash"
        label="Make a folder, write a note, then show it: the note says hi."
        lines={[{ cmd: 'mkdir demo && cd demo' }, { cmd: 'echo "hi" > note.txt' }, { cmd: 'cat note.txt' }, { out: 'hi', color: 'green' }]}
      />
    </section>

    <section class="dev-demo card-content" data-demo="repo-merge" aria-labelledby="demo-repo-merge">
      <h2 id="demo-repo-merge">PracticeRepo: review and merge</h2>
      <Interactive
        name="PracticeRepo"
        screen="pull"
        repo={repo}
        issues={issues}
        pulls={[pull]}
        settings={{ rules: [{ id: 'requireReview', label: 'Require one approving review', on: true }, { id: 'requireChecks', label: 'Require checks to pass', on: true }] }}
        task={{ type: 'merge', pr: 7 }}
      />
    </section>

    <section class="dev-demo card-content" data-demo="repo-run" aria-labelledby="demo-repo-run">
      <h2 id="demo-repo-run">PracticeRepo: find the failing step</h2>
      <Interactive name="PracticeRepo" screen="run" at={12} repo={repo} runs={[run]} task={{ type: 'findFailingStep', run: 12 }} />
    </section>

    <section class="dev-demo card-content" data-demo="repo-suggest" aria-labelledby="demo-repo-suggest">
      <h2 id="demo-repo-suggest">PracticeRepo: suggest a change</h2>
      <Interactive name="PracticeRepo" screen="pull-files" repo={repo} pulls={[pull]} task={{ type: 'suggest', pr: 7 }} />
    </section>

    <section class="dev-demo card-content" data-demo="repo-label" aria-labelledby="demo-repo-label">
      <h2 id="demo-repo-label">PracticeRepo: label an issue</h2>
      <Interactive name="PracticeRepo" screen="issues" repo={repo} issues={issues} task={{ type: 'label', issue: 4, label: 'bug' }} />
    </section>

    <section class="dev-demo card-content" data-demo="markdown" aria-labelledby="demo-markdown">
      <h2 id="demo-markdown">MarkdownPlayground</h2>
      <Interactive
        name="MarkdownPlayground"
        initial={'# My project\n\nA short line about it.\n'}
        prompt="Add a heading called Install and a task list item."
        goal={{ mustMatch: ['^##\\s+Install', '^- \\[ \\] '], hint: ['Start a line with ## Install', 'Start a line with - [ ] '] }}
        success="Your README has a section and a to-do list."
      />
    </section>

    <section class="dev-demo card-content" data-demo="yaml" aria-labelledby="demo-yaml">
      <h2 id="demo-yaml">YamlBuilder</h2>
      <Interactive name="YamlBuilder" workflow="CI" blocks={blocks} goal={{ order: ['push', 'job', 'checkout', 'node', 'test'] }} />
    </section>

    <section class="dev-demo card-content" data-demo="mission" aria-labelledby="demo-mission">
      <h2 id="demo-mission">MissionCheck</h2>
      <Interactive
        name="MissionCheck"
        checks={[
          { type: 'repo', repo: 'diary', label: 'Your diary repo is public' },
          { type: 'commits', repo: 'diary', min: 3, label: 'It has 3 or more commits' },
          { type: 'file', repo: 'diary', path: 'README.md', label: 'It has a README.md' },
        ]}
        success="GitHub can see your diary!"
      />
    </section>

    <!-- World 3: branches, conflicts, interactive rebase -->
    <section class="dev-demo card-content" data-demo="universe" aria-labelledby="demo-universe">
      <h2 id="demo-universe">UniverseSplitter: visit both universes</h2>
      <Interactive name="UniverseSplitter" scenario="w03-l02-split" file="index.html" task={{ type: 'visitAll' }} />
    </section>

    <section class="dev-demo card-content" data-demo="universe-create" aria-labelledby="demo-universe-create">
      <h2 id="demo-universe-create">UniverseSplitter: make a branch at a commit</h2>
      <Interactive name="UniverseSplitter" scenario="w03-l01" task={{ type: 'create', at: '^Add day 1 page$', name: 'idea' }} prompt="Stick a note called idea on the commit “Add day 1 page”." />
    </section>

    <section class="dev-demo card-content" data-demo="conflict" aria-labelledby="demo-conflict">
      <h2 id="demo-conflict">ConflictResolver: one conflict, editor look</h2>
      <Interactive name="ConflictResolver" scenario="w03-l06" commands={['git merge cake']} look="editor" graph expect={['learned branches', 'baked a cake']} why="Keep both day 2 lines." />
    </section>

    <section class="dev-demo card-content" data-demo="conflict-three" aria-labelledby="demo-conflict-three">
      <h2 id="demo-conflict-three">ConflictResolver: three conflicts in two files</h2>
      <Interactive
        name="ConflictResolver"
        scenario="w03-boss-merge"
        commands={['git merge party']}
        expect={{ 'index.html': ['My Git Diary', 'I fixed conflicts', 'Party time'], 'style.css': 'hotpink' }}
        avoid={{ 'index.html': 'Party Diary' }}
        prompt="Title: keep yours. Day 5: keep both. Colour: keep theirs."
      />
    </section>

    <section class="dev-demo card-content" data-demo="rebase" aria-labelledby="demo-rebase">
      <h2 id="demo-rebase">RebaseDeck: move, fixup, drop</h2>
      <Interactive
        name="RebaseDeck"
        scenario="w03-l11b"
        upstream="main"
        goal={{ messages: ['^Add photo captions$', '^Add gallery page$', '^Add style$'], commits: 5, filesMissing: ['debug.txt'] }}
        commitFiles={[{ message: '^Add gallery page$', file: 'gallery.html', contains: 'My Gallery' }]}
        hints={['Move “fix typo” right under “Add gallery page”.']}
      />
    </section>

    <!-- World 4: push/pull courier (tests/e2e/courier.spec.ts) -->
    <section class="dev-demo card-content" data-demo="courier-fix" aria-labelledby="demo-courier-fix">
      <h2 id="demo-courier-fix">Courier: push rejected, pull, push</h2>
      <Interactive
        name="Courier"
        scenario="w04-l09"
        actions={['push', 'fetch', { cmd: 'git pull --rebase', label: 'Pull (rebase)' }]}
        goal={{ pushed: ['main'], serverHas: { url: 'https://github.com/you/diary.git', branch: 'main', hasMessage: 'Aisyah' } }}
        hints={['Bring in Aisyah’s commit first: tap Pull (rebase).', 'Then tap Push again.']}
        success="Both commits are on GitHub now."
      />
    </section>

    <section class="dev-demo card-content" data-demo="courier-team" aria-labelledby="demo-courier-team">
      <h2 id="demo-courier-team">Courier: a teammate pushes; fetch, then pull</h2>
      <Interactive
        name="Courier"
        scenario="w04-team"
        actions={['commit', 'push', 'teammate', 'fetch', 'pull']}
        teammate={{ name: 'Aisyah', dir: '/home/aisyah/diary', commits: [{ file: 'index.html', append: '<p>Day 3: Aisyah again</p>\n', message: 'Add Aisyah’s day 3' }] }}
        mine={[{ file: 'about.html', content: '<h1>About me</h1>\n', message: 'Add about page' }]}
        goal={{ branchAt: { main: 'Aisyah' }, aheadBehind: { ahead: 0, behind: 0 } }}
      />
    </section>

    <section class="dev-demo card-content" data-demo="courier-demo" aria-labelledby="demo-courier-demo">
      <h2 id="demo-courier-demo">Courier: demo</h2>
      <Interactive
        name="Courier"
        scenario="w04-l05"
        commands={['git push -u origin main']}
        label="The courier carries three commits from your laptop to the empty GitHub repo. Now main follows origin/main."
      />
    </section>

    <section class="dev-demo card-content" data-demo="xray" aria-labelledby="demo-xray">
      <h2 id="demo-xray">ObjectXray</h2>
      <Interactive name="ObjectXray" scenario="w10-objects" task={{ type: 'findBlob', path: 'css/style.css' }} />
    </section>

    <section class="dev-demo card-content" data-demo="detective" aria-labelledby="demo-detective">
      <h2 id="demo-detective">BisectDetective</h2>
      <Interactive
        name="BisectDetective"
        scenario="w10-bisect"
        test={{ file: 'index.html', bad: 'RM0', label: 'The test: the price in index.html must not be RM0.' }}
      />
    </section>

    <!-- Ship It: the kitchen engine (tests/e2e/kitchen.spec.ts) -->
    <section class="dev-demo card-content" data-demo="kitchen-sim" aria-labelledby="demo-kitchen-sim">
      <h2 id="demo-kitchen-sim">KitchenSim: run nginx and open a hatch</h2>
      <Interactive
        name="KitchenSim"
        course="docker"
        scenario="d1-nginx"
        goal={{ running: ['web'], reachable: 'localhost:8080', lastTyped: '^curl' }}
        hints={['Type docker run -d --name web -p 8080:80 nginx:1.30-alpine', 'Then curl localhost:8080 to see the page.']}
        success="Your lunchbox serves the page through hatch 8080."
      />
    </section>

    <section class="dev-demo card-content" data-demo="kitchen-replay" aria-labelledby="demo-kitchen-replay">
      <h2 id="demo-kitchen-replay">KitchenReplay: build and run the diary</h2>
      <Interactive
        name="KitchenReplay"
        course="docker"
        scenario="d2-diary-dockerfile"
        commands={['docker build -t diary:1.0 .', 'docker run -d --name diary -p 8080:80 diary:1.0', 'curl -s localhost:8080']}
        label="The recipe becomes the image diary:1.0. A container from it serves the diary page on port 8080."
      />
    </section>

    <!-- Level Up · Linux: the practice server (tests/e2e/linux.spec.ts) -->
    <section class="dev-demo card-content" data-demo="linux-sim" aria-labelledby="demo-linux-sim">
      <h2 id="demo-linux-sim">LinuxSim: make the script runnable, then run it</h2>
      <Interactive
        name="LinuxSim"
        scenario="linux-perms"
        goal={{ fileMode: { '~/shop/open.sh': 'x' }, lastTyped: '^(\\./|bash )open\\.sh' }}
        hints={['Type chmod +x open.sh', 'Then run it: ./open.sh']}
        solution={['chmod +x open.sh', './open.sh']}
        success="The script can run now, and it opened the shop."
      />
    </section>

    <section class="dev-demo card-content" data-demo="linux-net" aria-labelledby="demo-linux-net">
      <h2 id="demo-linux-net">LinuxSim: a web server that won't start</h2>
      <Interactive
        name="LinuxSim"
        scenario="linux-nginx-down"
        network
        goal={{ serviceActive: ['nginx'], portListening: [80] }}
        hints={['Ask nginx to check its settings: sudo nginx -t', "Fix the typo: sudo sed -i 's/lisen/listen/' /etc/nginx/sites-available/default", 'Then: sudo systemctl start nginx']}
        solution={["sudo sed -i 's/lisen/listen/' /etc/nginx/sites-available/default", 'sudo systemctl start nginx']}
        success="nginx is running and port 80 answers again."
      />
    </section>

    <!-- Ship It · Docker D0: YAML basics (tests/e2e/yaml-playground.spec.ts) -->
    <section class="dev-demo card-content" data-demo="yaml-list" aria-labelledby="demo-yaml-list">
      <h2 id="demo-yaml-list">YamlPlayground: add a list item</h2>
      <Interactive
        name="YamlPlayground"
        file="order.yaml"
        initial={'dish: nasi lemak\nsides:\n  - sambal\n  - egg\n'}
        prompt="Add cucumber as a third side."
        expect={[{ path: 'sides', type: 'list', count: 3, includes: 'cucumber', hint: 'Add a new line under egg: two spaces, a dash, a space, then cucumber.' }]}
        solution={'dish: nasi lemak\nsides:\n  - sambal\n  - egg\n  - cucumber\n'}
        hint="Copy the egg line, then change the word."
        success="Three sides!"
      />
    </section>

    <section class="dev-demo card-content" data-demo="yaml-indent" aria-labelledby="demo-yaml-indent">
      <h2 id="demo-yaml-indent">YamlPlayground: fix an indent</h2>
      <Interactive
        name="YamlPlayground"
        file="tiffin.yaml"
        initial={'tiffin:\n  top: rice\n middle: chicken curry\n  bottom: sambal\n'}
        prompt="Put middle back inside the tiffin."
        expect={[{ path: 'tiffin', type: 'map', count: 3, hint: 'middle needs the same two spaces as top.' }, { path: 'tiffin.middle', equals: 'chicken curry' }]}
        solution={'tiffin:\n  top: rice\n  middle: chicken curry\n  bottom: sambal\n'}
      />
    </section>

    <!-- Ship It · Kubernetes games (tests/e2e/k8s-games.spec.ts). Props come from src/lib/k8sDemos.ts. -->
    <section class="dev-demo card-content" data-demo="k8s-sched" aria-labelledby="demo-k8s-sched">
      <h2 id="demo-k8s-sched">SchedulerTetris</h2>
      <Interactive name="SchedulerTetris" nodes={schedDemo.nodes} pods={schedDemo.pods} keys={schedDemo.keys} task={schedDemo.task} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-labels" aria-labelledby="demo-k8s-labels">
      <h2 id="demo-k8s-labels">LabelMatchmaker: Service</h2>
      <Interactive name="LabelMatchmaker" pods={labelsDemo.pods} labels={labelsDemo.labels} selector={labelsDemo.selector} task={labelsDemo.task} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-template" aria-labelledby="demo-k8s-template">
      <h2 id="demo-k8s-template">LabelMatchmaker: Deployment template</h2>
      <Interactive name="LabelMatchmaker" pods={templateDemo.pods} labels={templateDemo.labels} selector={templateDemo.selector} templateLabels={templateDemo.templateLabels} task={templateDemo.task} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-trace" aria-labelledby="demo-k8s-trace">
      <h2 id="demo-k8s-trace">RequestTracer: make it 503</h2>
      <Interactive name="RequestTracer" route={traceDemo} breaks={['path', 'listener', 'serviceName', 'selector', 'targetPort', 'ready', 'policy']} task={{ type: 'outcome', want: '503' }} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-trace-fix" aria-labelledby="demo-k8s-trace-fix">
      <h2 id="demo-k8s-trace-fix">RequestTracer: fix it</h2>
      <Interactive name="RequestTracer" route={traceDemo} breaks={['targetPort', 'policy']} broken={['targetPort']} task={{ type: 'deliver' }} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-doctor" aria-labelledby="demo-k8s-doctor">
      <h2 id="demo-k8s-doctor">YamlDoctor: indentation</h2>
      <Interactive name="YamlDoctor" manifest={doctorDemo.broken} solution={doctorDemo.fixed} file={doctorDemo.file} hint={doctorDemo.hint} keep={doctorDemo.keep} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-doctor-typo" aria-labelledby="demo-k8s-doctor-typo">
      <h2 id="demo-k8s-doctor-typo">YamlDoctor: misspelt field</h2>
      <Interactive name="YamlDoctor" manifest={doctorTypoDemo.broken} solution={doctorTypoDemo.fixed} file={doctorTypoDemo.file} hint={doctorTypoDemo.hint} keep={doctorTypoDemo.keep} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-rbac" aria-labelledby="demo-k8s-rbac">
      <h2 id="demo-k8s-rbac">RbacSwitchboard: least privilege for the CI bot</h2>
      <Interactive name="RbacSwitchboard" subjects={rbacDemo.subjects} roles={rbacDemo.roles} bindings={rbacDemo.bindings} questions={rbacDemo.questions} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-rbac-predict" aria-labelledby="demo-k8s-rbac-predict">
      <h2 id="demo-k8s-rbac-predict">RbacSwitchboard: predict</h2>
      <Interactive name="RbacSwitchboard" subjects={rbacPredictDemo.subjects} roles={rbacPredictDemo.roles} bindings={rbacPredictDemo.bindings} questions={rbacPredictDemo.questions} task={{ type: 'predict' }} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-mirror" aria-labelledby="demo-k8s-mirror">
      <h2 id="demo-k8s-mirror">GitOpsMirror: change Git</h2>
      <Interactive name="GitOpsMirror" app={mirrorApp} task={{ type: 'gitChange', field: 'replicas', to: 5 }} />
    </section>

    <section class="dev-demo card-content" data-demo="k8s-mirror-drift" aria-labelledby="demo-k8s-mirror-drift">
      <h2 id="demo-k8s-mirror-drift">GitOpsMirror: drift without self-heal</h2>
      <Interactive name="GitOpsMirror" app={mirrorApp} selfHeal={false} task={{ type: 'drift' }} />
    </section>

    <!-- Ship It part 2 (CI/CD): conveyor engine games (tests/e2e/conveyor.spec.ts) -->
    <section class="dev-demo card-content" data-demo="conveyor-predict" aria-labelledby="demo-conveyor-predict">
      <h2 id="demo-conveyor-predict">ConveyorBelt: predict the red station</h2>
      <Interactive name="ConveyorBelt" course="cicd" scenario="c1-broken-test" task={{ type: 'predict' }} />
    </section>

    <section class="dev-demo card-content" data-demo="conveyor-fix" aria-labelledby="demo-conveyor-fix">
      <h2 id="demo-conveyor-fix">ConveyorBelt: pick a fix</h2>
      <Interactive
        name="ConveyorBelt"
        course="cicd"
        scenario="c2-fix-permissions"
        task={{ type: 'green' }}
        fixes={[
          { label: 'contents: write', text: 'permissions:\n  contents: write', why: 'Writing code is not the same as writing packages.' },
          { label: 'write-all', text: 'permissions: write-all', why: 'Every step would get every key.', correct: false },
          { label: 'contents: read and packages: write', text: 'permissions:\n  contents: read\n  packages: write' },
        ]}
      />
    </section>

    <section class="dev-demo card-content" data-demo="conveyor-edit" aria-labelledby="demo-conveyor-edit">
      <h2 id="demo-conveyor-edit">ConveyorBelt: type the fix</h2>
      <Interactive name="ConveyorBelt" course="cicd" scenario="c2-fix-permissions" editable task={{ type: 'green', forbid: ['write-all'] }} />
    </section>

    <section class="dev-demo card-content" data-demo="conveyor-matrix" aria-labelledby="demo-conveyor-matrix">
      <h2 id="demo-conveyor-matrix">ConveyorBelt: a container pipeline with a matrix</h2>
      <Interactive name="ConveyorBelt" course="cicd" scenario="c2-container-pipeline" event="pr" label="Test on Node 22 and 24, then build the image. Pushes publish it; pull requests only build it." />
    </section>

    <section class="dev-demo card-content" data-demo="conveyor-approve" aria-labelledby="demo-conveyor-approve">
      <h2 id="demo-conveyor-approve">ConveyorBelt: approve production</h2>
      <Interactive name="ConveyorBelt" course="cicd" scenario="c3-release" task={{ type: 'approve' }} />
    </section>

    <section class="dev-demo card-content" data-demo="conveyor-cache" aria-labelledby="demo-conveyor-cache">
