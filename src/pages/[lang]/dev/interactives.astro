<script>
  // Mark a demo as done when its interactive says so (lesson cards do the same).
  for (const type of ['fl:done', 'fl:wrong'] as const) {
    document.addEventListener(type, (e) => {
      const demo = (e.target as HTMLElement).closest<HTMLElement>('[data-demo]');
      if (!demo) return;
      if (type === 'fl:done') demo.dataset.done = 'true';
      else demo.dataset.wrong = String(Number(demo.dataset.wrong ?? 0) + 1);
    });
  }
</script>

