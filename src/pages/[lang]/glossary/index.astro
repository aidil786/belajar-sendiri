---
// /en/glossary/: the first course's glossary (other courses: /en/<course>/glossary/).
import GlossaryPage from '~/components/pages/GlossaryPage.astro';
import { LANGS, type Lang } from '~/i18n';
import { ROOT_COURSE } from '~/lib/catalog';
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---

<GlossaryPage lang={lang} courseId={ROOT_COURSE} />
