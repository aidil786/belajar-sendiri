---
// Level Up overview (docs/LEVEL-UP-PLAN.md §1): Linux, Terraform & OpenTofu, Observability and AWS side
// by side in their course colours, every world as a tile with its code, "best after" tips (never locks),
// the capstone missions M7–M10, the shared Rescue Center and a link to the certification map.
import FamilyOverview from '~/components/pages/FamilyOverview.astro';
import FamilyExtra from '~/components/pages/FamilyExtra.astro';
import { LANGS, t, type Lang } from '~/i18n';
import { LEVEL_UP } from '~/lib/catalog';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---

<FamilyOverview lang={lang} family={LEVEL_UP}>
  <FamilyExtra
    id="certs-h"
    tone="certs"
    icon="star"
    title={t(lang, 'certs.title')}
    text={t(lang, 'levelup.certsText')}
    href={`/${lang}/ship-it/certifications/`}
    linkText={t(lang, 'certs.open')}
    data-certs-link
  />
</FamilyOverview>
