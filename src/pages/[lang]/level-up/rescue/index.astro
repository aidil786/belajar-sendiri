---
// Level Up Rescue Center: the Linux, Terraform & OpenTofu, Observability and AWS flows, one section
// per part (FamilyRescue). Works with zero flows: each part says "coming soon" calmly.
import FamilyRescue from '~/components/pages/FamilyRescue.astro';
import { LANGS, type Lang } from '~/i18n';
import { LEVEL_UP } from '~/lib/catalog';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---

<FamilyRescue lang={lang} family={LEVEL_UP} />
