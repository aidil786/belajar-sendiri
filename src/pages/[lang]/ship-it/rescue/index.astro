---
// Ship It Rescue Center: the Docker, CI/CD and Kubernetes flows, one section per part (FamilyRescue).
import FamilyRescue from '~/components/pages/FamilyRescue.astro';
import { LANGS, type Lang } from '~/i18n';
import { SHIP_IT } from '~/lib/catalog';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---

<FamilyRescue lang={lang} family={SHIP_IT} />
