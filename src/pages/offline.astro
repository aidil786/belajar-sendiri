---
// Bilingual offline page. The service worker shows it when there is no internet
// and the page you asked for was never saved. It lists the pages you can still open.
import '~/styles/global.css';
import Mascot from '~/components/ui/Mascot.astro';
import { t } from '~/i18n';
---

<!doctype html>
<html lang="en" data-calm="false" data-font="atkinson">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{t('en', 'offline.title')} · {t('ms', 'offline.title')} · FahamLah</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem('fahamlah:v1') || '{}').settings || {};
        if (s.theme === 'light' || s.theme === 'dark') document.documentElement.dataset.theme = s.theme;
        document.documentElement.dataset.calm = String(!!s.calm);
      } catch {}
    </script>
  </head>
  <body>
    <main id="main" class="sheet">
      <div class="container off">
      <div aria-hidden="true"><Mascot lang="en" mood="thinking" size={110} /></div>
      <section>
        <h1>{t('en', 'offline.title')}</h1>
        <p>{t('en', 'offline.text')}</p>
        <p class="links">
          <button type="button" class="btn" data-retry>{t('en', 'offline.retry')}</button>
          <a class="btn btn-ghost" href="/en/">{t('en', 'offline.home')}</a>
        </p>
      </section>
      <section lang="ms">
        <h2>{t('ms', 'offline.title')}</h2>
        <p>{t('ms', 'offline.text')}</p>
        <p class="links">
          <button type="button" class="btn btn-ghost" data-retry>{t('ms', 'offline.retry')}</button>
          <a class="btn btn-ghost" href="/ms/">{t('ms', 'offline.home')}</a>
        </p>
      </section>
      <section data-saved hidden>
        <h2>{t('en', 'offline.saved')} <span lang="ms">/ {t('ms', 'offline.saved')}</span></h2>
        <ul class="saved" data-saved-list></ul>
      </section>
      </div>
    </main>
  </body>
</html>

<script>
  for (const b of document.querySelectorAll('[data-retry]')) b.addEventListener('click', () => location.reload());

  // List the pages saved on this device (titles come from the saved copies).
  const list = async () => {
    if (!('caches' in window)) return;
    const names = (await caches.keys()).filter((k) => k.startsWith('fahamlah-pages-') || k.startsWith('fahamlah-shell-'));
    const seen = new Map<string, string>();
    for (const name of names) {
      const cache = await caches.open(name);
      for (const req of await cache.keys()) {
        const path = new URL(req.url).pathname;
        if (seen.has(path) || !/^\/(en|ms)\//.test(path) || !path.endsWith('/')) continue;
        const res = await cache.match(req);
        const html = res ? await res.text() : '';
        const title = /<title>([^<]*)<\/title>/.exec(html)?.[1] ?? path;
        seen.set(path, title.replace(/&amp;/g, '&').replace(/&#39;/g, "'").replace(/&quot;/g, '"'));
        if (seen.size >= 200) break;
      }
    }
    if (!seen.size) return;
    const ul = document.querySelector<HTMLElement>('[data-saved-list]')!;
    const items = [...seen].sort(([a], [b]) => a.localeCompare(b));
    ul.replaceChildren(
      ...items.map(([path, title]) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = path;
        a.textContent = title;
        a.lang = path.slice(1, 3);
        li.append(a);
        return li;
      }),
    );
    document.querySelector<HTMLElement>('[data-saved]')!.hidden = false;
  };
  list().catch(() => {});
</script>

<style>
  .off {
    padding-block: var(--space-3);
    max-width: 40rem;
    display: grid;
    gap: var(--space-4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .saved {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-5);
  }
  .saved a {
    display: inline-flex;
    min-height: var(--tap);
    align-items: center;
  }
</style>
