// Cloudflare Pages: a fully static site (Astro builds dist/), no Functions, no secrets.
// The project name is the address: https://belajarsendiri.pages.dev
// Docs: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belajarsendiri",
  // Astro's build output. Pages serves /en/ from /en/index.html, redirects /en to /en/,
  // and answers unknown paths with dist/404.html (status 404).
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-30"
}
